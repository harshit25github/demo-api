{
  "name": "coa-flight-agent",
  "version": "1.0.0",
  "description": "Basic Flight Agent setup using the OpenAI Agents SDK.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "dev:chat": "tsx src/api/chat/server.ts",
    "test:chat-api": "tsx --test tests/integration/chat-api.test.ts",
    "start": "tsx examples/test-flight-agent.ts",
    "test:flight": "tsx examples/test-flight-agent.ts",
    "test:extractor-prompts": "tsx --test tests/unit/extractor-prompts-static.test.ts",
    "test:summary-agent": "tsx --test tests/unit/summary-agent-context.test.ts tests/unit/extractor-prompts-static.test.ts",
    "test:summary-agent:live": "tsx tests/live/summary-agent-live-eval.ts",
    "test:summary-agent:passengers-live": "tsx tests/live/summary-agent-live-eval.ts --passenger-only",
    "test:summary-agent:date-live": "tsx tests/live/summary-agent-live-eval.ts --date-only",
    "test:link-sanitizer": "tsx --test tests/unit/link-sanitizer.test.ts",
    "test:trip-planner": "tsx --test tests/unit/trip-planner-agent.test.ts tests/unit/trip-planner-optimization.test.ts",
    "test:trip-planner:agent-owned-context": "tsx --test tests/unit/trip-planner-agent-owned-context.test.ts",
    "test:trip-planner:agent-owned-context-live": "tsx tests/live/trip-planner-agent-owned-context-live.ts",
    "test:trip-planner:live": "tsx examples/test-trip-planner-agent.ts",
    "test:trip-planner:mobile-multiturn": "tsx tests/live/trip-planner-mobile-multiturn-live.ts",
    "test:trip-planner:context-journey": "tsx tests/live/trip-planner-context-journey-multiturn-live.ts",
    "test:trip-planner:web-search": "tsx tests/live/trip-planner-web-search-intelligence-live.ts",
    "test:trip-planner:context-web-search": "tsx tests/live/trip-planner-summary-context-web-search-live.ts",
    "test:apply-filter:fuzzy": "tsx --test tests/unit/apply-filter-fuzzy-source-matching.test.ts",
    "test:tools": "tsx --test tests/integration/flight-agent-tools.test.ts",
    "test:flight:session": "tsx --test tests/live/flight-agent-session-live.ts",
    "test:flight:session-report": "tsx tests/live/flight-agent-session-complex-report-live.ts",
    "test:flight:airline": "tsx --test tests/live/flight-agent-airline-filter-live.ts",
    "test:flight:layover-airport": "tsx --test tests/live/flight-agent-layover-airport-filter-live.ts",
    "test:flight:tool-routing": "tsx tests/live/flight-agent-tool-routing-complex-live.ts",
    "test:flight:prefilled-context": "tsx tests/live/flight-agent-prefilled-context-live.ts",
    "test:flight:search-filter-flow": "tsx --test tests/integration/flight-agent-search-filter-flow.test.ts",
    "test:flight:current-results": "tsx --test tests/live/flight-agent-current-results-reasoning-live.ts",
    "test:flight:airport-all-options": "tsx tests/live/flight-agent-airport-all-options-live.ts",
    "test:flight:deep-chats": "tsx tests/live/flight-agent-deep-chats-live.ts",
    "test:flight:intelligence-deep-chats": "tsx tests/live/flight-agent-intelligence-deep-chats-live.ts",
    "test:flight:basic-queries": "tsx tests/live/flight-agent-basic-queries-live.ts",
    "test:flight:suggested-questions": "tsx --test tests/unit/flight-agent-suggested-questions.test.ts",
    "test:flight:suggested-questions-variation": "tsx tests/live/flight-agent-suggested-questions-variation-live.ts",
    "gaps:suggested-questions": "tsx scripts/write-suggested-questions-gap-register.ts",
    "test:flight:context-carry-forward": "tsx --test tests/integration/flight-agent-context-carry-forward.test.ts",
    "test:flight:price-prediction": "tsx --test tests/unit/flight-agent-price-prediction.test.ts",
    "test:flight:price-prediction-live": "tsx tests/live/flight-agent-price-prediction-routing-live.ts",
    "test:flight:price-date-intelligence": "tsx tests/live/flight-agent-price-prediction-date-intelligence-live.ts",
    "test:flight:date-price-accuracy": "tsx tests/live/flight-agent-date-routing-live.ts",
    "test:flight:price-note": "tsx --test tests/live/flight-agent-price-per-person-note-live.ts",
    "test:guardrail:post-booking": "tsx tests/live/post-booking-guardrail-live.ts",
    "verify:manager-e2e": "tsx scripts/verify-manager-e2e.ts",
    "test:flight:multiturn": "tsx tests/live/flight-agent-multiturn-live.ts",
    "test:flight:complex": "tsx tests/live/flight-agent-complex-multiturn-live.ts",
    "test:flight:e2e-multiturn": "tsx tests/live/flight-agent-e2e-multiturn-live.ts",
    "test:sdk-contract": "tsx --test tests/integration/sdk-agent-tool-contract.test.ts",
    "test:manager:registration": "tsx --test tests/integration/manager-specialist-registration.test.ts tests/integration/manager-flight-registration.test.ts",
    "test:manager:acceptance": "tsx --test tests/integration/manager-acceptance.test.ts",
    "smoke:manager": "tsx scripts/smoke-manager-routing.ts"
  },
  "dependencies": {
    "@openai/agents": "^0.18.0",
    "@openai/agents-openai": "^0.18.0",
    "@toon-format/toon": "^4.1.1",
    "dotenv": "^17.4.2",
    "lucide": "^1.33.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
